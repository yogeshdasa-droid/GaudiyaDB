{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaudiya Database",
  "version": "0.1.0",
  "identifier": "com.whispers.wdatabase",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gaudiya Database",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Gaudiya Database: biblioteca de búsqueda de textos",
    "windows": {
      "nsis": { "languages": ["Spanish", "English"], "displayLanguageSelector": true }
    }
  }
}
